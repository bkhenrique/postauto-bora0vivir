# Legenda (Claude no Amazon Bedrock)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# IA_MODELO=global.anthropic.claude-sonnet-4-6
# IA_ESFORCO=low

# Captura. O Chrome visível é o que passa pelo bloqueio dos portais.
# NAVEGADOR_VISIVEL=true
# NAVEGADOR_CANAL=chrome

# Capa do carrossel
# MARCA_NOME=Vivir en España
# MARCA_COR_FUNDO=#16213E
# MARCA_COR_DESTAQUE=#FFC72C

# Instagram (necessário só para publicar)
INSTAGRAM_TOKEN=
INSTAGRAM_USUARIO_ID=
# INSTAGRAM_API_VERSAO=v25.0

# Hospedagem pública das fotos: bucket S3 ou Cloudflare R2 (necessário só para publicar)
ARMAZENAMENTO_BUCKET=
ARMAZENAMENTO_URL_PUBLICA=
# Para R2: https://<account-id>.r2.cloudflarestorage.com
ARMAZENAMENTO_ENDPOINT=
# ARMAZENAMENTO_REGIAO=auto
# Se ficarem vazias, usa as credenciais AWS de cima
ARMAZENAMENTO_ACCESS_KEY_ID=
ARMAZENAMENTO_SECRET_ACCESS_KEY=

# WhatsApp: id do grupo de controle (mande !id no grupo com o bot ligado para descobrir)
WHATSAPP_GRUPO_ID=

# Idealista bloqueia o IP ao detectar automação; só ligue se souber o que está fazendo
# IDEALISTA_AUTOMATICO=false
